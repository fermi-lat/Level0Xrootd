  <task name="RePipe" type="Data" version="1.6">
    <variables>
      <var name="taskBase">/afs/slac.stanford.edu/g/glast/isoc/flightOps/offline/halfPipe/RePipe</var>
      <var name="outputBase">/nfs/farm/g/glast/u28/RePipe</var>
      <var name="level1Name">L1Proc</var>
      <var name="startL1">0</var>
      <var name="fmxRoot">/afs/slac.stanford.edu/g/glast/fmx</var>
      <var name="pipelineFlavor">PROD</var>
      <var name="numChunks">2</var>
      <var name="chunkApids">956,957</var>
      <var name="fosFlavor">ISOC_PROD</var>
      <var name="dbPrefix">glastops</var>
      <var name="maxEvents">125000</var>
      <var name="withOrphans">no</var>
    </variables>
    <prerequisites>
      <prerequisite name="downlinkID" type="integer" />
      <prerequisite name="runID" type="integer" />
    </prerequisites>
    <process name="makeChunks">
      <job batchOptions=" -q short -R &quot;select[ ! rhel30 ]&quot; " 
	   executable="${taskBase}/scripts/RePipe.py --apid ${chunkApids} --prefix ${dbPrefix} --outbase ${outputBase} --downlink ${downlinkID} --runid ${runID}">
      </job>
    </process>
    <process name="launchChunks">
      <script><![CDATA[
            
            for i in range(0, int(numChunks)):
               pipeline.createSubstream("doChunk", i+1)
            
         ]]></script>
      <depends>
	<after process="makeChunks" status="SUCCESS" />
      </depends>
      <createsSubtasks>
        <subtask>doChunk</subtask>
      </createsSubtasks>
    </process>
    <process name="mergeEvt">
      <job batchOptions=" -q long " 
	   executable="${taskBase}/scripts/mergeRePipe.sh" />
      <depends>
        <after process="doChunk.makeEvt" status="SUCCESS" />
      </depends>
    </process>
    <task name="doChunk" type="Data" version="1.0">
      <process name="makeEvt">
        <variables>
	  <var name="HALFPIPE_DOWNLINKID">${format(downlinkID, "%09d")}</var>
	  <var name="HALFPIPE_NUMCHUNKS">${numChunks}</var>
	  <var name="HALFPIPE_OUTPUTBASE">${outputBase}</var>
	  <var name="HALFPIPE_CHUNKID">${format(pipeline.stream, "%05d")}</var>
	  <var name="HALFPIPE_FOSFLAVOR">${fosFlavor}</var>
	  <var name="HALFPIPE_FMXROOT">${fmxRoot}</var>
        </variables>
        <job batchOptions=" -q long -E &quot;${taskBase}/scripts/checkNFS.sh&quot; " executable="${taskBase}/scripts/makeEvt.sh" />
      </process>
    </task>
